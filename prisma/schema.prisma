generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

/// 계정. 회원가입 화면은 없다 - 최초 1명은 셋업 화면에서, 이후는 관리자가 만드는
/// 초대 링크로만 늘어난다. 첫 계정은 자동으로 관리자가 된다.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  /// 로그인 차단 시각. 계정은 지우지 않는다 - 소유한 노트/할 일/프로젝트가
  /// 전부 이 사용자를 참조하므로, 삭제하면 그 참조가 깨진다.
  disabledAt   DateTime?
  createdAt    DateTime @default(now())

  /// MCP 인증 토큰의 해시(SHA-256, hex). 평문 토큰은 발급 시 한 번만 보여주고 저장하지 않는다.
  mcpTokenHash String? @unique

  projectMemberships ProjectMember[]
  ownedNotes         Note[]          @relation("NoteOwner")
  ownedTodos         Todo[]          @relation("TodoOwner")
  ownedSecrets       Secret[]        @relation("SecretOwner")
  invitesCreated     Invite[]        @relation("InviteCreatedBy")
  invitesUsed        Invite[]        @relation("InviteUsedBy")
}

/// 관리자가 발급하는 1회용 계정 초대. 회원가입 화면 대신 이걸로만 계정이 늘어난다.
model Invite {
  id        String    @id @default(cuid())
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  createdById String
  createdBy   User   @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  usedById String? @unique
  usedBy   User?   @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([expiresAt])
}

enum ProjectRole {
  OWNER
  MEMBER
}

/// 프로젝트 멤버십. OWNER는 멤버 관리·프로젝트 삭제 권한이 있고, MEMBER는
/// 그 프로젝트 안의 노트/할 일/비밀번호를 보고 쓸 수 있다.
model ProjectMember {
  id     String      @id @default(cuid())
  role   ProjectRole @default(MEMBER)
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

/// 작업 단위. 노트와 할 일이 여기에 묶인다. 미분류(projectId = null)는 만든 사람의
/// 개인 공간이고, 프로젝트에 배정되면 그 프로젝트 멤버 전원이 본다.
model Project {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// 사이드바 점 색상 (#rrggbb)
  color       String?
  /// 이 프로젝트가 어느 코드 저장소의 것인지 (http/https URL). 연결되어 있으면
  /// 작업일지에 빌드 줄을 요구한다 - 코드와 무관한 프로젝트는 그냥 저장된다.
  repoUrl     String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members ProjectMember[]
  notes   Note[]
  todos   Todo[]
  secrets Secret[]

  @@index([archived, name])
}

enum NoteKind {
  NOTE
  WORKLOG
  SNIPPET
}

model Note {
  id        String   @id @default(cuid())
  kind      NoteKind @default(NOTE)
  title     String
  /// 본문. 마크다운 원문 그대로 - 저장할 때도 읽을 때도 변환하지 않는다.
  /// 표시할 때만 HTML로 렌더한다(src/lib/note-render.ts).
  body      String   @default("")
  pinned    Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 만든 사람. projectId가 null일 때(미분류) 이 사람만 볼 수 있다.
  ownerId String
  owner   User   @relation("NoteOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// 로그인 없이 볼 수 있는 공개 읽기 전용 링크. null이면 비공개.
  shareToken String?   @unique
  sharedAt   DateTime?

  tags        Tag[]
  attachments Attachment[]
  todos       Todo[]

  @@index([kind, updatedAt])
  @@index([archived, updatedAt])
  @@index([projectId, updatedAt])
  @@index([ownerId, projectId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  notes Note[]
}

model Attachment {
  id           String   @id @default(cuid())
  noteId       String
  note         Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  /// Name shown to the user
  originalName String
  /// Name on disk under ATTACHMENTS_DIR
  storedName   String   @unique
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([noteId])
}

/// 자격증명. 노트/할 일과 똑같은 규칙으로 보인다 - 미분류(projectId = null)는 만든
/// 사람만, 프로젝트에 넣으면 그 멤버 전원이 본다. 값은 서버 키로만 풀리므로
/// 데이터베이스나 백업만 새어나가도 열리지 않는다. 자세한 내용은 docs/security.md.
model Secret {
  id       String  @id @default(cuid())
  title    String
  username String?
  url      String?
  memo     String?
  /// AES-256-GCM 암호문 ("iv:ciphertext:tag", 각각 base64). 서버 키로만 풀린다.
  valueCipher String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// 만든 사람. projectId가 null일 때(미분류) 이 사람만 볼 수 있다.
  ownerId String
  owner   User   @relation("SecretOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([ownerId, title])
  @@index([ownerId, projectId])
  @@index([projectId, title])
}

/// 할 일의 성격. 오류사항 / 개선사항 / 아이디어 / 일반 할 일.
enum TodoKind {
  BUG
  IMPROVEMENT
  IDEA
  TASK
}

enum TodoStatus {
  TODO
  DOING
  DONE
}

/// 프로젝트별 할 일. 노트와 마찬가지로 미분류(projectId = null)는 만든 사람만 본다.
model Todo {
  id     String     @id @default(cuid())
  kind   TodoKind   @default(TASK)
  status TodoStatus @default(TODO)
  title  String
  detail String?

  ownerId String
  owner   User   @relation("TodoOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// 이 할 일이 나온 노트. 노트가 지워져도 할 일은 남는다.
  noteId String?
  note   Note?   @relation(fields: [noteId], references: [id], onDelete: SetNull)

  /// 노트 본문에서 이 할 일이 가리키는 대목을 그대로 인용해 둔 것. 위치를 줄 번호로
  /// 잡으면 앞에 줄이 추가될 때 조용히 엉뚱한 곳을 가리키므로, 본문에서 이 문장을
  /// 찾아 위치를 정한다. 그 문장이 고쳐지면 못 찾고, 그건 화면에 그대로 드러난다.
  anchorText String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  doneAt    DateTime?

  @@index([projectId, status])
  @@index([status, updatedAt])
  @@index([ownerId, projectId])
}
