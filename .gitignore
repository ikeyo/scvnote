# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ScvNote
/data
/src/generated
!.env.example

# local-only compose override (gates app/migrate behind the prod-test profile,
# hardcodes a dev-only db port). Docker Compose auto-loads this file if it's
# present, so it must never reach the NAS via git clone - see compose.override.yaml
/compose.override.yaml
