# ---- Postgres (read by both docker compose and the app) ----
POSTGRES_USER=scvnote
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scvnote

# ---- App ----
# 3000 and 3001 are used by other projects on this machine
APP_PORT=3100

# Local development: Next.js runs on the host and reaches the container via the published port.
# In the compose stack this value is overridden to point at the `db` service.
DATABASE_URL=postgresql://scvnote:change-me@localhost:5434/scvnote

# Where uploaded screenshots / files are stored (host path in dev, /data/attachments in the container)
ATTACHMENTS_DIR=./data/attachments

# Session signing secret. Generate with:  openssl rand -base64 32
AUTH_SECRET=

# The first account created at /login becomes the admin automatically -
# there's no separate admin bootstrap value here. Everyone after that signs
# up through an admin-issued invite link. MCP tokens are per-account too,
# issued from /settings - see docs/mcp.md. Neither needs an .env entry.
